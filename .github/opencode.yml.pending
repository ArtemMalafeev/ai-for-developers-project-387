# Замена .github/workflows/opencode.yml после установки новых workflow.
# GitHub App, которым пушит OpenCode, не имеет права создавать или менять файлы
# в .github/workflows. Человек должен заменить содержимое
# .github/workflows/opencode.yml этим файлом.
#
# События комментариев на PR теперь обрабатывает opencode-review-comments.yml:
# именно там действует бюджет из трёх запросов /oc и публикуются итоги.
# Этот workflow оставлен для /oc в обычных issue.
name: OpenCode

on:
  issue_comment:
    types: [created]

concurrency:
  group: opencode-issue-${{ github.event.issue.number }}
  cancel-in-progress: false

permissions: {}

jobs:
  opencode:
    if: >-
      (contains(github.event.comment.body, '/oc') || contains(github.event.comment.body, '/opencode')) &&
      github.event.comment.user.type != 'Bot' &&
      contains(fromJSON('["OWNER","MEMBER","COLLABORATOR"]'), github.event.comment.author_association) &&
      github.event.issue.pull_request == null
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    permissions:
      contents: read
      id-token: write
    steps:
      - name: Checkout default branch
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          ref: ${{ github.event.repository.default_branch }}
          persist-credentials: false

      - name: Checkout agent skills
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          repository: mattpocock/skills
          ref: 4ae2317ddb22b046e26455e4f9c9b3aaaf62212d # v1.3.2
          path: .agent-skill-source
          persist-credentials: false

      - name: Make agent skills available
        run: |
          mkdir -p .opencode/skills
          cp -R .agent-skill-source/skills/engineering/. .opencode/skills/
          cp -R .agent-skill-source/skills/productivity/. .opencode/skills/
          test "$(find .opencode/skills -name SKILL.md | wc -l | tr -d ' ')" = 27
          printf '%s\n' '/.opencode/skills/' >> .git/info/exclude
          rm -rf .agent-skill-source

      - name: Run OpenCode
        uses: anomalyco/opencode/github@17b79f4e0c16dcff200b0417567ed22aeb2d7166 # github-v1.2.28
        env:
          OPENCODE_API_KEY: ${{ secrets.OPENCODE_API_KEY }}
          # A GitHub runner cannot answer permission prompts from OpenCode.
          OPENCODE_CONFIG_CONTENT: |-
            {
              "permission": {
                "external_directory": {
                  "*": "deny",
                  "/tmp/*": "allow"
                },
                "doom_loop": "deny",
                "read": {
                  "*.env": "deny",
                  "*.env.*": "deny",
                  "*.env.example": "allow"
                }
              }
            }
        with:
          model: opencode/deepseek-v4.1-flash
          mentions: /opencode,/oc
          share: false
