# Готовый workflow ручных запросов /oc на pull request.
# GitHub App, которым пушит OpenCode, не имеет права создавать файлы в
# .github/workflows. Человек должен перенести этот файл в
# .github/workflows/opencode-review-comments.yml и закоммитить его обычными правами.
#
# Сначала отдельное задание gate проверяет доверие и бюджет. Только после
# успешного gate запускается прежний anomalyco/opencode/github, который читает
# общий или построчный комментарий и может исправить код. Бюджет считается по
# истории GitHub Actions, а не по комментарию PR: токен GitHub App разработчика
# не должен иметь возможности переписать счётчик.
name: OpenCode Review Request

on:
  issue_comment:
    types: [created]
  pull_request_review_comment:
    types: [created]

run-name: OpenCode request gate PR #${{ github.event.issue.number || github.event.pull_request.number }} attempt ${{ github.run_attempt }}

concurrency:
  group: opencode-review-request-${{ github.event.issue.number || github.event.pull_request.number }}
  cancel-in-progress: false

permissions: {}

jobs:
  gate:
    name: Gate request
    if: >-
      (contains(github.event.comment.body, '/oc') || contains(github.event.comment.body, '/opencode')) &&
      github.event.comment.user.type != 'Bot' &&
      contains(fromJSON('["OWNER","MEMBER","COLLABORATOR"]'), github.event.comment.author_association) &&
      (github.event_name == 'pull_request_review_comment' || github.event.issue.pull_request != null)
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    permissions:
      contents: read
      pull-requests: read
      actions: read
    outputs:
      admitted: ${{ steps.guard.outputs.admitted }}
      reason: ${{ steps.guard.outputs.reason }}
      used: ${{ steps.guard.outputs.used }}
      head_sha: ${{ steps.guard.outputs.head_sha }}
      pr_number: ${{ steps.pr.outputs.number }}
    steps:
      - name: Checkout trusted default branch
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          ref: ${{ github.event.repository.default_branch }}
          persist-credentials: false

      - name: Resolve pull request number
        id: pr
        env:
          EVENT_NAME: ${{ github.event_name }}
          ISSUE_NUMBER: ${{ github.event.issue.number }}
          PULL_REQUEST_NUMBER: ${{ github.event.pull_request.number }}
        run: |
          set -euo pipefail
          if [ "$EVENT_NAME" = "pull_request_review_comment" ]; then
            printf 'number=%s\n' "$PULL_REQUEST_NUMBER" >> "$GITHUB_OUTPUT"
          else
            printf 'number=%s\n' "$ISSUE_NUMBER" >> "$GITHUB_OUTPUT"
          fi

      - name: Check trust and request budget
        id: guard
        env:
          GH_TOKEN: ${{ github.token }}
          REPO: ${{ github.repository }}
          PR_NUMBER: ${{ steps.pr.outputs.number }}
          MAX_REQUESTS: "3"
        run: bash scripts/opencode-review/request-guard.sh

      - name: Write gate artifact
        if: always()
        env:
          OUTPUT_PATH: .opencode-request/gate.json
          PR_NUMBER: ${{ steps.pr.outputs.number }}
          HEAD_SHA: ${{ steps.guard.outputs.head_sha }}
          ADMITTED: ${{ steps.guard.outputs.admitted }}
          REASON: ${{ steps.guard.outputs.reason }}
          USED: ${{ steps.guard.outputs.used }}
          LIMIT: "3"
          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
        run: bash scripts/opencode-review/write-gate-artifact.sh

      - name: Upload gate artifact
        if: always()
        uses: actions/upload-artifact@330a01c490aca151604b8cf639adc76d48f6c5d4 # v5
        with:
          name: opencode-request-gate-${{ github.run_id }}-${{ github.run_attempt }}
          path: .opencode-request/gate.json
          if-no-files-found: warn
          retention-days: 7

      - name: Enforce gate
        if: steps.guard.outputs.admitted != 'true'
        env:
          REASON: ${{ steps.guard.outputs.reason }}
        run: |
          set -euo pipefail
          printf 'Request not admitted: %s\n' "$REASON"
          exit 1

  agent:
    name: Agent request
    needs: gate
    if: needs.gate.outputs.admitted == 'true'
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    permissions:
      contents: read
      id-token: write
    steps:
      - name: Checkout trusted default branch
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          ref: ${{ github.event.repository.default_branch }}
          persist-credentials: false

      - name: Preflight agent request
        id: preflight
        env:
          OPENCODE_API_KEY: ${{ secrets.OPENCODE_API_KEY }}
          GATE_ADMITTED: ${{ needs.gate.outputs.admitted }}
          HEAD_SHA: ${{ needs.gate.outputs.head_sha }}
        run: bash scripts/opencode-review/preflight.sh

      - name: Checkout agent skills
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          repository: mattpocock/skills
          ref: 4ae2317ddb22b046e26455e4f9c9b3aaaf62212d # v1.3.2
          path: .agent-skill-source
          persist-credentials: false

      - name: Make agent skills available
        run: |
          mkdir -p .opencode/skills
          cp -R .agent-skill-source/skills/engineering/. .opencode/skills/
          cp -R .agent-skill-source/skills/productivity/. .opencode/skills/
          test "$(find .opencode/skills -name SKILL.md | wc -l | tr -d ' ')" = 27
          printf '%s\n' '/.opencode/skills/' >> .git/info/exclude
          rm -rf .agent-skill-source

      - name: Build normalized event for inline comment
        if: github.event_name == 'pull_request_review_comment'
        id: inline
        run: bash scripts/opencode-review/build-mock-event.sh

      - name: Exchange OIDC token for inline comment
        if: github.event_name == 'pull_request_review_comment'
        id: app-token
        run: |
          set -euo pipefail
          id_token="$(curl -fsS -H "Authorization: Bearer $ACTIONS_ID_TOKEN_REQUEST_TOKEN" \
            "${ACTIONS_ID_TOKEN_REQUEST_URL}&audience=opencode-github-action" | jq -r .value)"
          app_token="$(curl -fsS -X POST -H "Authorization: Bearer $id_token" \
            https://api.opencode.ai/exchange_github_app_token | jq -r .token)"
          if [ -z "$app_token" ] || [ "$app_token" = "null" ]; then
            echo "App token exchange failed" >&2
            exit 1
          fi
          echo "::add-mask::$app_token"
          printf 'token=%s\n' "$app_token" >> "$GITHUB_OUTPUT"

      - name: Configure git for inline comment
        if: github.event_name == 'pull_request_review_comment'
        env:
          APP_TOKEN: ${{ steps.app-token.outputs.token }}
        run: |
          set -euo pipefail
          auth="$(printf 'x-access-token:%s' "$APP_TOKEN" | base64 -w0)"
          git config --local --unset-all http.https://github.com/.extraheader || true
          git config --local http.https://github.com/.extraheader "AUTHORIZATION: basic $auth"

      - name: Run OpenCode developer agent
        uses: anomalyco/opencode/github@17b79f4e0c16dcff200b0417567ed22aeb2d7166 # github-v1.2.28
        env:
          OPENCODE_API_KEY: ${{ secrets.OPENCODE_API_KEY }}
          # A GitHub runner cannot answer permission prompts from OpenCode.
          OPENCODE_CONFIG_CONTENT: |-
            {
              "permission": {
                "external_directory": {
                  "*": "deny",
                  "/tmp/*": "allow"
                },
                "doom_loop": "deny",
                "read": {
                  "*.env": "deny",
                  "*.env.*": "deny",
                  "*.env.example": "allow"
                }
              }
            }
          TOKEN: ${{ github.event_name == 'pull_request_review_comment' && steps.app-token.outputs.token || '' }}
          MOCK_EVENT: ${{ github.event_name == 'pull_request_review_comment' && steps.inline.outputs.context || '' }}
        with:
          model: opencode/deepseek-v4.1-flash
          mentions: /opencode,/oc
          share: false

      - name: Remove temporary git credentials
        if: always() && github.event_name == 'pull_request_review_comment'
        run: git config --local --unset-all http.https://github.com/.extraheader || true

  summary:
    needs: [gate, agent]
    if: >-
      always() &&
      (contains(github.event.comment.body, '/oc') || contains(github.event.comment.body, '/opencode')) &&
      github.event.comment.user.type != 'Bot' &&
      contains(fromJSON('["OWNER","MEMBER","COLLABORATOR"]'), github.event.comment.author_association) &&
      (github.event_name == 'pull_request_review_comment' || github.event.issue.pull_request != null)
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    permissions:
      pull-requests: write
    steps:
      - name: Checkout trusted default branch
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          ref: ${{ github.event.repository.default_branch }}
          persist-credentials: false

      - name: Publish gate decision
        env:
          GH_TOKEN: ${{ github.token }}
          REPO: ${{ github.repository }}
          PR_NUMBER: ${{ needs.gate.outputs.pr_number || github.event.issue.number || github.event.pull_request.number }}
          GATE_ADMITTED: ${{ needs.gate.outputs.admitted }}
          GATE_REASON: ${{ needs.gate.outputs.reason }}
          GATE_USED: ${{ needs.gate.outputs.used }}
          GATE_RESULT: ${{ needs.gate.result }}
          HEAD_SHA: ${{ needs.gate.outputs.head_sha }}
          RUN_ID: ${{ github.run_id }}
          RUN_ATTEMPT: ${{ github.run_attempt }}
          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
        run: |
          set -euo pipefail

          # Admitted requests are published by the agent itself on success and
          # by the trusted workflow_run finalizer on timeout, cancellation,
          # setup/install errors and agent failures. This job owns only the
          # gate decision, which the finalizer must not duplicate.
          if [ "$GATE_ADMITTED" = "true" ]; then
            printf 'Request admitted; abnormal outcomes belong to the finalizer\n'
            exit 0
          fi

          reason="$GATE_REASON"
          if [ -z "$reason" ]; then
            case "$GATE_RESULT" in
              cancelled) reason=cancelled ;;
              *) reason=infra ;;
            esac
          fi

          head_sha="$HEAD_SHA"
          if [ -z "$head_sha" ]; then
            head_sha="$(gh pr view "$PR_NUMBER" --repo "$REPO" --json headRefOid --jq .headRefOid 2>/dev/null || true)"
          fi
          head_sha="${head_sha:-unknown}"

          REASON="$reason" \
          HEAD_SHA="$head_sha" \
          RUN_URL="$RUN_URL" \
          REVIEW_PATH="" \
          USED="$GATE_USED" \
          LIMIT="3" \
          RUN_ID="$RUN_ID" \
          RUN_ATTEMPT="$RUN_ATTEMPT" \
          OUTPUT_PATH=.opencode-request/comment.md \
            bash scripts/opencode-review/publish-result.sh

          gh pr comment "$PR_NUMBER" --repo "$REPO" --body-file .opencode-request/comment.md
